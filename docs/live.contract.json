      "source": "ocr.snapshot",
      "pointer": "/metrics/auto_fast_percent",
      "time": "/at",
      "mode": "static",
      "unit": "%",
      "public": "same",
      "note": "只说明没有升级，不是准确率或已核准够用。"
    },
    {
      "id": "unknown",
      "label": "识别器未给质量结论的原件",
      "source": "ocr.snapshot",
      "pointer": "/metrics/unknown",
      "time": "/at",
      "mode": "static",
      "unit": "份",
      "public": "same"
    },
    {
      "id": "sufficient",
